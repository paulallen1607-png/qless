{
  "name": "qless-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QLess food court API (Node built-in HTTP + node:sqlite, no native modules)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=src src/index.js",
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js --reset"
  }
}
